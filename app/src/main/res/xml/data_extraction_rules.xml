<?xml version="1.0" encoding="utf-8"?>
<!-- Back up sightings, but not the preferences DataStore containing a
     user-supplied API credential, via cloud backup or device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/mycelium_settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/mycelium_settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
